# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,toml,json}]
indent_size = 2

# Trailing double spaces are a Markdown line break.
[*.md]
trim_trailing_whitespace = false

[justfile]
indent_size = 4
